# Contoh .env untuk SERVER PRODUKSI (cPanel) — simpan sebagai backend/.env di server.
# Jangan pernah meng-commit berkas .env yang berisi nilai asli.

APP_NAME="Aplikasi Bengkel"
APP_ENV=production
APP_KEY=                      # diisi oleh: php artisan key:generate
APP_DEBUG=false               # WAJIB false — kalau true, pesan galat internal bisa terbaca pengunjung
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api-bengkel.domain-anda.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=namauser_bengkel   # di cPanel: lihat Databases → nama lengkap berawalan user
DB_USERNAME=namauser_bengkel
DB_PASSWORD=                   # password user database dari cPanel (buat sendiri, jangan bawaan)

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Origin SPA yang diizinkan (dipisah koma). Tanpa ini, aplikasi web akan diblokir CORS.
FRONTEND_URL=https://bengkel.domain-anda.com

# Akun owner awal (dipakai seeder OwnerUserSeeder) — GANTI password setelah masuk pertama
OWNER_NAME="Pemilik Bengkel"
OWNER_EMAIL=owner@domain-anda.com
OWNER_PASSWORD=ganti-password-ini

# Identitas bengkel (dipakai SettingSeeder; bisa diubah kapan saja lewat menu Pengaturan)
SHOP_NAME="Nama Bengkel"
SHOP_ADDRESS="Alamat bengkel"
SHOP_PHONE="08xxxxxxxxxx"
