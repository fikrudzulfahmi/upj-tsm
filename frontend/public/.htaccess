# SPA Vue Router (history mode) di Apache/LiteSpeed cPanel.
#
# Tanpa berkas ini, alamat seperti /kasir atau /customers akan 404 saat di-refresh
# atau dibuka langsung (bookmark, tautan WhatsApp), karena tidak ada berkas fisik
# dengan nama itu. Semua permintaan yang bukan berkas/direktori nyata dialihkan
# ke index.html, lalu Vue Router menangani rutenya.
#
# Berkas ini ada di frontend/public/ sehingga Vite otomatis menyalinnya ke dist/.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jangan alihkan berkas yang memang ada (aset, favicon, dsb.)
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Aset ber-hash dari Vite boleh dicache lama; index.html tidak boleh.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|gif|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
